---
/**
 * Flecha decorativa de trazo a mano (path con irregularidad sutil,
 * stroke-linecap: round) que dirige la vista desde la cabecera hacia el
 * contenido. Decorativa: aria-hidden y oculta en móvil.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 100 130"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class:list={["pointer-events-none select-none", className]}
>
  <!-- Trazo principal, con curvas levemente irregulares -->
  <path d="M12 6 C 26 28, 8 52, 22 76 C 30 90, 40 102, 56 110"></path>
  <!-- Punta de flecha, a mano -->
  <path d="M51 98 C 53 102, 55 106, 56 110"></path>
  <path d="M43 111 C 47 111, 52 110, 56 110"></path>
</svg>
