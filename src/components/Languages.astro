---
/**
 * Idiomas: nombre y nivel legibles + indicador discreto de puntos.
 * El indicador usa role="img" con aria-label para lectores de pantalla.
 */
import { cv } from "../data/cv";

const MAX_DOTS = 5;
---

<section id="idiomas" aria-labelledby="idiomas-title" data-reveal>
  <h2 id="idiomas-title" class="section-title">Idiomas</h2>
  <span class="section-rule" aria-hidden="true"></span>

  <ul class="mt-7 space-y-4">
    {
      cv.languages.map((lang) => (
        <li class="flex min-h-11 items-center justify-between gap-4">
          <p class="text-[0.95rem]">
            <span class="font-medium text-ink">{lang.name}</span>
            <span class="text-muted"> · {lang.levelLabel}</span>
          </p>
          <span
            role="img"
            aria-label={`${lang.name}: ${lang.levelLabel}`}
            class="flex shrink-0 items-center gap-1.5"
          >
            {Array.from({ length: MAX_DOTS }, (_, i) => (
              <span
                aria-hidden="true"
                class:list={[
                  "size-2 rounded-full transition-colors",
                  i < lang.level ? "bg-accent" : "border border-line bg-transparent",
                ]}
              />
            ))}
          </span>
        </li>
      ))
    }
  </ul>
</section>
