---
/**
 * Contacto: lista con iconos de línea minimalistas dentro de un <address>
 * semántico. Enlaces con área táctil generosa (≥44px).
 */
import { cv } from "../data/cv";

interface ContactItem {
  id: string;
  label: string;
  href?: string;
  value: string;
  extraAttrs?: Record<string, string>;
  icon: "phone" | "mail" | "whatsapp" | "pin";
}

import { logos } from "../data/logos";

const items: ContactItem[] = [
  { id: "telefono", label: "Teléfono", href: cv.contact.phoneHref, value: cv.contact.phone, icon: "phone" },
  {
    id: "email",
    label: "Email",
    href: `mailto:${cv.contact.email}`,
    value: cv.contact.email,
    icon: "mail",
  },
  {
    id: "whatsapp",
    label: "WhatsApp",
    href: cv.contact.whatsappUrl,
    value: "Abrir WhatsApp",
    extraAttrs: { target: "_blank", rel: "noopener noreferrer" },
    icon: "whatsapp",
  },
  { id: "ubicacion", label: "Ubicación", value: cv.contact.location, icon: "pin" },
];

const strokeIcon = {
  width: "20",
  height: "20",
  viewBox: "0 0 24 24",
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "1.75",
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
  "aria-hidden": "true",
  class: "size-5 shrink-0 text-ink",
} as const;
---

<section id="contacto" aria-labelledby="contacto-title" data-reveal>
  <h2 id="contacto-title" class="section-title">Contacto</h2>
  <span class="section-rule" aria-hidden="true"></span>

  <address class="mt-7 not-italic">
    <ul class="space-y-1">
      {
        items.map((item) => (
          <li class="flex items-stretch gap-3.5">
            <span class="flex min-h-11 items-center" aria-hidden="true">
              {item.icon === "phone" && (
                <svg {...strokeIcon}>
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
              )}
              {item.icon === "mail" && (
                <svg {...strokeIcon}>
                  <rect height="16" rx="2" width="20" x="2" y="4" />
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
                </svg>
              )}
              {item.icon === "whatsapp" && (
                <svg
                  aria-hidden="true"
                  class="size-5 shrink-0 text-ink"
                  set:html={logos.whatsapp}
                />
              )}
              {item.icon === "pin" && (
                <svg {...strokeIcon}>
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
              )}
            </span>

            {item.href ? (
              <a
                href={item.href}
                {...item.extraAttrs}
                class="flex min-h-11 items-center text-[0.95rem] text-graphite underline-offset-4 transition-colors duration-200 hover:text-ink hover:underline break-all"
              >
                <span class="sr-only">{item.label}: </span>{item.value}
              </a>
            ) : (
              <p class="flex min-h-11 items-center text-[0.95rem] text-graphite">
                <span class="sr-only">{item.label}: </span>{item.value}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </address>
</section>
